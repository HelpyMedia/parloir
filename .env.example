# ── EDITION ────────────────────────────────────────────────────────────────
# 1 = public hosted service: OpenRouter is the only provider, local model
# servers are disabled, per-user debate caps apply. Leave empty to self-host
# with every provider (OpenRouter, Anthropic, OpenAI, Google, Ollama, LM Studio).
PARLOIR_HOSTED=

# ── DATABASE ───────────────────────────────────────────────────────────────
# Postgres with the pgvector extension. Neon, Supabase, or local docker compose.
# POSTGRES_PASSWORD is required by docker-compose.yml — change it beyond local dev.
POSTGRES_PASSWORD=parloir_dev
DATABASE_URL=postgres://parloir:parloir_dev@localhost:5432/parloir

# ── DURABLE EXECUTION ──────────────────────────────────────────────────────
# Inngest runs debates step by step. Leave empty for local dev (the dev
# server auto-discovers). Required in production.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── APP / AUTH ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000   # must be https:// in production (localhost excepted)
BETTER_AUTH_SECRET=                     # openssl rand -base64 32

# ── ENCRYPTION ─────────────────────────────────────────────────────────────
# Encrypts users' stored API keys. 32 bytes, base64: openssl rand -base64 32
# Changing it makes every stored key unreadable.
PARLOIR_ENCRYPTION_KEY=

# ── EMAIL (optional) ───────────────────────────────────────────────────────
# When set, new accounts must confirm their email before signing in.
RESEND_API_KEY=
PARLOIR_EMAIL_FROM="Parloir <no-reply@parloir.dev>"

# ── PUBLIC SERVICE (optional) ──────────────────────────────────────────────
# Shown on /privacy and /terms.
PARLOIR_CONTACT_EMAIL=
# Debate caps per user. Defaults: 40/day and 2 running when PARLOIR_HOSTED=1,
# unlimited otherwise.
PARLOIR_MAX_SESSIONS_PER_DAY=
PARLOIR_MAX_CONCURRENT_SESSIONS=

# ── PROVIDERS ──────────────────────────────────────────────────────────────
# Users bring their own keys in Settings; the server needs none. For
# single-user local development only, PARLOIR_DEV_INHERIT_ENV=1 lets debates
# use the keys below (refused in production).
PARLOIR_DEV_INHERIT_ENV=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1
VLLM_BASE_URL=

# Point OpenRouter traffic at a compatible proxy, or at the local mock
# (pnpm dev:mock-openrouter → http://localhost:4010/api/v1). Normally empty.
PARLOIR_OPENROUTER_BASE_URL=

# ── OBSERVABILITY (optional, not wired yet) ────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
